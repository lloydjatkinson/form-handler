<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableSdkContainerDebugging>True</EnableSdkContainerDebugging>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
    <ContainerImageName>form-handler</ContainerImageName>
    <UserSecretsId>dc22acea-0965-4fb1-b1d1-742f6acf835f</UserSecretsId>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Templates\StandardEmailTemplate.mjml.scriban" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="FluentMigrator" />
    <PackageReference Include="FluentMigrator.Runner.Postgres" />
    <PackageReference Include="Humanizer.Core" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Npgsql.DependencyInjection" />
    <PackageReference Include="Mjml.Net" />
    <PackageReference Include="Scriban" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ContainerPort Include="8081" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\StandardEmailTemplate.mjml.scriban" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Forms\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Infrastructure\Email\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>FormHandler.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>


</Project>
