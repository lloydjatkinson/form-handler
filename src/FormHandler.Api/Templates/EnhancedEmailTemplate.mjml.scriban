<mjml>
    <mj-head>
        <mj-attributes>
            <mj-all font-family="Arial, Helvetica, sans-serif" />
            <mj-text color="#222222" font-size="14px" line-height="1.6" />
        </mj-attributes>
        <mj-style>
            table.fields { border-collapse: collapse; }
        </mj-style>
    </mj-head>

    <mj-body background-color="#f4f4f4" width="600px">

        <mj-section background-color="{{ branding.primary_color }}" padding="20px 32px">
            <mj-column>
                <mj-text color="#ffffff" font-size="20px" font-weight="bold">
                    {{ form.name | html.escape }}
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#ffffff" padding="28px 32px 8px">
            <mj-column>
                <mj-text font-size="18px" font-weight="bold" color="#111827" padding="0 0 2px">
                    New submission received
                </mj-text>
                <mj-text font-size="13px" color="#6b7280" padding="0">
                    Submitted on {{ submission.submitted_at }}
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#ffffff" padding="12px 32px 0">
            <mj-column>
                <mj-table css-class="fields" cellpadding="0" cellspacing="0" width="100%" padding="0" font-size="14px" line-height="1.6">
                    {{ for field in form.fields }}
                    <tr>
                        <td style="width:180px;vertical-align:top;padding:14px 20px;background-color:#f9fafb;border:1px solid #e5e7eb;font-weight:bold;color:#374151;">{{ field.label | html.escape }}</td>
                        <td style="vertical-align:top;padding:14px 20px;border:1px solid #e5e7eb;color:#222222;">{{ submission.values[field.name] | html.escape }}</td>
                    </tr>
                    {{ end }}
                </mj-table>
            </mj-column>
        </mj-section>

        <mj-section background-color="#ffffff" padding="22px 32px 28px">
            <mj-column>
                {{ if assembly_version }}
                <mj-text font-size="11px" color="#9ca3af" align="center" padding="0">
                    Powered by FormHandler {{ assembly_version }}
                </mj-text>
                {{ end }}
            </mj-column>
        </mj-section>

    </mj-body>
</mjml>
